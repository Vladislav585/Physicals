<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EFEAD8"
    tools:context=".Density"
    tools:ignore="SpeakableTextPresentCheck">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/textView25"
            android:layout_width="125dp"
            android:layout_height="58dp"
            android:layout_marginTop="40dp"
            android:text="@string/tetxview"
            android:textColor="#EFEAD8"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.083"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/Answ"
            tools:ignore="TextContrastCheck" />

        <TextView
            android:id="@+id/Answ"
            android:layout_width="363dp"
            android:layout_height="52dp"
            android:layout_marginTop="30dp"
            android:background="#6D8B74"
            android:gravity="center"
            android:text="@string/Answer_TextView"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textView23" />

        <TextView
            android:id="@+id/textView23"
            android:layout_width="307dp"
            android:layout_height="39dp"
            android:layout_marginTop="40dp"
            android:text="@string/Answer_title"
            android:textAlignment="textStart"
            android:textColor="#5F7161"
            android:textSize="24sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.298"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/solvingButtonDensity"
            tools:ignore="TextContrastCheck" />

        <Button
            android:id="@+id/solvingButtonDensity"
            android:layout_width="349dp"
            android:layout_height="59dp"
            android:layout_marginTop="30dp"
            android:backgroundTint="#6D8B74"
            android:onClick="SolveDensity"
            android:text="@string/Solv"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/spinnerFindDensity" />

        <Spinner
            android:id="@+id/spinnerFindDensity"
            android:layout_width="260dp"
            android:layout_height="52dp"
            android:layout_marginTop="15dp"
            android:backgroundTint="#5F7161"
            android:entries="@array/Values_Find_For_Density"
            android:spinnerMode="dropdown"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.211"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textView15"
            tools:ignore="SpeakableTextPresentCheck" />

        <TextView
            android:id="@+id/textView15"
            android:layout_width="307dp"
            android:layout_height="39dp"
            android:layout_marginTop="35dp"
            android:text="@string/Find_title"
            android:textAlignment="textStart"
            android:textColor="#5F7161"
            android:textSize="24sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.307"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/inputPO"
            tools:ignore="TextContrastCheck" />

        <Spinner
            android:id="@+id/spinnerForDensity"
            android:layout_width="112dp"
            android:layout_height="53dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="#5F7161"
            android:entries="@array/Values_Density"
            android:spinnerMode="dropdown"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toEndOf="@+id/inputPO"
            app:layout_constraintTop_toBottomOf="@+id/textView14"
            tools:ignore="SpeakableTextPresentCheck" />

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/inputPO"
            android:layout_width="154dp"
            android:layout_height="54dp"
            android:layout_marginTop="15dp"
            android:hint="@string/InputDensity"
            android:inputType="numberDecimal"
            android:singleLine="false"
            android:textColor="#5F7161"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.124"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textView14"
            tools:ignore="TouchTargetSizeCheck,TextContrastCheck" />

        <TextView
            android:id="@+id/textView14"
            android:layout_width="307dp"
            android:layout_height="39dp"
            android:layout_marginTop="24dp"
            android:text="@string/Input_Density_title"
            android:textAlignment="textStart"
            android:textColor="#5F7161"
            android:textSize="24sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.307"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/inputV"
            tools:ignore="TextContrastCheck" />

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/inputV"
            android:layout_width="154dp"
            android:layout_height="54dp"
            android:layout_marginTop="15dp"
            android:hint="@string/InputV"
            android:inputType="numberDecimal"
            android:singleLine="false"
            android:textColor="#5F7161"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.124"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textView13"
            tools:ignore="TouchTargetSizeCheck,TextContrastCheck" />

        <TextView
            android:id="@+id/textView13"
            android:layout_width="307dp"
            android:layout_height="39dp"
            android:layout_marginTop="25dp"
            android:text="@string/Volume_title"
            android:textAlignment="textStart"
            android:textColor="#5F7161"
            android:textSize="24sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.307"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/inputMD"
            tools:ignore="TextContrastCheck" />

        <Spinner
            android:id="@+id/spinnerForVolume"
            android:layout_width="100dp"
            android:layout_height="55dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="36dp"
            android:backgroundTint="#5F7161"
            android:entries="@array/Values_Volume"
            android:spinnerMode="dropdown"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toEndOf="@+id/inputV"
            app:layout_constraintTop_toBottomOf="@+id/textView13"
            tools:ignore="SpeakableTextPresentCheck" />

        <Spinner
            android:id="@+id/spinnerForWeightD"
            android:layout_width="100dp"
            android:layout_height="55dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="36dp"
            android:backgroundTint="#5F7161"
            android:entries="@array/Values_weight"
            android:spinnerMode="dropdown"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toEndOf="@+id/inputMD"
            app:layout_constraintTop_toBottomOf="@+id/textView12"
            tools:ignore="SpeakableTextPresentCheck" />

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/inputMD"
            android:layout_width="154dp"
            android:layout_height="54dp"
            android:layout_marginTop="15dp"
            android:hint="@string/Hint_m"
            android:inputType="numberDecimal"
            android:singleLine="false"
            android:textColor="#5F7161"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.124"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textView12"
            tools:ignore="TouchTargetSizeCheck,TextContrastCheck" />

        <TextView
            android:id="@+id/textView11"
            android:layout_width="304dp"
            android:layout_height="68dp"
            android:layout_marginTop="60dp"
            android:text="@string/Density_title"
            android:textAlignment="center"
            android:textColor="#5F7161"
            android:textSize="24sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.523"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/textView12"
            android:layout_width="307dp"
            android:layout_height="39dp"
            android:layout_marginTop="40dp"
            android:text="@string/Input_m"
            android:textAlignment="textStart"
            android:textColor="#5F7161"
            android:textSize="24sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.307"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textView11"
            tools:ignore="TextContrastCheck" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>