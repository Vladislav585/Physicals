<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EFEAD8"
    tools:context=".Pressure"
    tools:ignore="SpeakableTextPresentCheck">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/textView99"
            android:layout_width="125dp"
            android:layout_height="58dp"
            android:layout_marginTop="40dp"
            android:text="@string/tetxview"
            android:textColor="#EFEAD8"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/AnswerToQuestion"
            tools:ignore="TextContrastCheck" />

        <TextView
            android:id="@+id/AnswerToQuestion"
            android:layout_width="363dp"
            android:layout_height="52dp"
            android:layout_marginTop="30dp"
            android:background="#6D8B74"
            android:gravity="center"
            android:text="@string/Answer_TextView"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textView98" />

        <TextView
            android:id="@+id/textView98"
            android:layout_width="307dp"
            android:layout_height="39dp"
            android:layout_marginTop="30dp"
            android:text="@string/Answer_title"
            android:textAlignment="textStart"
            android:textColor="#5F7161"
            android:textSize="24sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.307"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/solvingButtonPressure"
            tools:ignore="TextContrastCheck" />

        <Button
            android:id="@+id/solvingButtonPressure"
            android:layout_width="349dp"
            android:layout_height="59dp"
            android:layout_marginTop="30dp"
            android:backgroundTint="#6D8B74"
            android:onClick="SolvePressure"
            android:text="@string/Solv"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.516"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/spinnerFindPressure" />

        <Spinner
            android:id="@+id/spinnerFindPressure"
            android:layout_width="260dp"
            android:layout_height="52dp"
            android:layout_marginTop="15dp"
            android:backgroundTint="#5F7161"
            android:entries="@array/Values_Find_For_Pressure"
            android:spinnerMode="dropdown"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.211"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textView97"
            tools:ignore="SpeakableTextPresentCheck" />

        <TextView
            android:id="@+id/textView97"
            android:layout_width="307dp"
            android:layout_height="39dp"
            android:layout_marginTop="30dp"
            android:text="@string/Find_title"
            android:textAlignment="textStart"
            android:textColor="#5F7161"
            android:textSize="24sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.307"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/inputS"
            tools:ignore="TextContrastCheck" />

        <TextView
            android:id="@+id/textView93"
            android:layout_width="304dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="60dp"
            android:text="@string/pressure_title"
            android:textAlignment="center"
            android:textColor="#5F7161"
            android:textSize="24sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.523"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/textView94"
            android:layout_width="307dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:text="@string/f_title"
            android:textAlignment="textStart"
            android:textColor="#5F7161"
            android:textSize="24sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.307"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textView93"
            tools:ignore="TextContrastCheck" />

        <TextView
            android:id="@+id/textView95"
            android:layout_width="307dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:text="@string/Pressure_title"
            android:textAlignment="textStart"
            android:textColor="#5F7161"
            android:textSize="24sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.307"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/inputPower"
            tools:ignore="TextContrastCheck" />

        <TextView
            android:id="@+id/textView96"
            android:layout_width="307dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:text="@string/s"
            android:textAlignment="textStart"
            android:textColor="#5F7161"
            android:textSize="24sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.307"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/inputPressure"
            tools:ignore="TextContrastCheck" />

        <Spinner
            android:id="@+id/spinnerForPower"
            android:layout_width="90dp"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="#5F7161"
            android:entries="@array/Values_Nuton"
            android:spinnerMode="dropdown"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toEndOf="@+id/inputPower"
            app:layout_constraintTop_toBottomOf="@+id/textView94"
            tools:ignore="SpeakableTextPresentCheck" />

        <Spinner
            android:id="@+id/spinnerForPaskal"
            android:layout_width="93dp"
            android:layout_height="49dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="#5F7161"
            android:entries="@array/Values_Paskal"
            android:spinnerMode="dropdown"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toEndOf="@+id/inputPressure"
            app:layout_constraintTop_toBottomOf="@+id/textView95"
            tools:ignore="SpeakableTextPresentCheck" />

        <Spinner
            android:id="@+id/spinnerForS"
            android:layout_width="93dp"
            android:layout_height="49dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="#5F7161"
            android:entries="@array/Values_S"
            android:spinnerMode="dropdown"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toEndOf="@+id/inputPressure"
            app:layout_constraintTop_toBottomOf="@+id/textView96"
            tools:ignore="SpeakableTextPresentCheck" />

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/inputPower"
            android:layout_width="154dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:hint="@string/inputF"
            android:inputType="numberDecimal"
            android:singleLine="false"
            android:textColor="#5F7161"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.124"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textView94"
            tools:ignore="TouchTargetSizeCheck,TextContrastCheck,DuplicateSpeakableTextCheck" />

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/inputPressure"
            android:layout_width="154dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:hint="@string/p_input"
            android:inputType="numberDecimal"
            android:singleLine="false"
            android:textColor="#5F7161"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.124"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textView95"
            tools:ignore="TouchTargetSizeCheck,TextContrastCheck" />

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/inputS"
            android:layout_width="154dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:hint="Введите S"
            android:inputType="numberDecimal"
            android:singleLine="false"
            android:textColor="#5F7161"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.124"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textView96"
            tools:ignore="TouchTargetSizeCheck,TextContrastCheck" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>